# Platform
CONFIG_MACH_XIAOMI_CEPHEUS=y

# Camera
CONFIG_VCM_AK7374=y

# Power
CONFIG_IDT_P9220=y

# Touchscreen
CONFIG_TOUCHSCREEN_ST_FTS_V521=y
CONFIG_FTS_FOD_AREA_REPORT=y
CONFIG_SECURE_TOUCH=y
CONFIG_I2C_BY_DMA=y

# Cmdline
CONFIG_CMDLINE="cgroup_disable=pressure earlycon=simplefb,0x9c000000,1080,2340 panic=10"
CONFIG_CMDLINE_EXTEND=y

# Simplefb earlycon
CONFIG_FB_EARLY=y
